{
  "name": "@ply/plugins",
  "version": "1.0.0",
  "description": "Plugin interfaces and helpers for agent providers",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./agents": {
      "development": "./src/agents/registry.ts",
      "types": "./dist/agents.d.mts",
      "default": "./dist/agents.mjs"
    },
    "./agents/types": {
      "development": "./src/agents/types.ts",
      "types": "./dist/agents/types.d.mts",
      "default": "./dist/agents/types.mjs"
    },
    "./integrations": {
      "development": "./src/integrations/index.ts",
      "types": "./dist/integrations.d.mts",
      "default": "./dist/integrations.mjs"
    },
    "./issues": {
      "development": "./src/issues/index.ts",
      "types": "./dist/issues.d.mts",
      "default": "./dist/issues.mjs"
    },
    "./pull-requests": {
      "development": "./src/pull-requests/index.ts",
      "types": "./dist/pull-requests.d.mts",
      "default": "./dist/pull-requests.mjs"
    },
    "./pull-requests/schemas": {
      "development": "./src/pull-requests/schemas.ts",
      "types": "./dist/pull-requests/schemas.d.mts",
      "default": "./dist/pull-requests/schemas.mjs"
    },
    "./pull-requests/types": {
      "development": "./src/pull-requests/types.ts",
      "types": "./dist/pull-requests/types.d.mts",
      "default": "./dist/pull-requests/types.mjs"
    },
    "./repository": {
      "development": "./src/repository/index.ts",
      "types": "./dist/repository.d.mts",
      "default": "./dist/repository.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --config-loader tsx --watch",
    "build": "tsdown --config-loader tsx && tsx tooling/validate-adapters.ts",
    "test": "pnpm exec nx test @ply/plugins",
    "test:watch": "pnpm exec nx run @ply/plugins:test-watch",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint src",
    "typecheck": "tsgo --noEmit",
    "generate:acp-fixture": "tsx tooling/fixtures/create-acp-transcript.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.329",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ply/core": "workspace:*",
    "@ply/shared": "workspace:*",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/codex-acp": "^1.13.1",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.69.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.28.2",
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build",
          "build"
        ],
        "options": {
          "command": "pnpm exec vitest run",
          "cwd": "packages/plugins"
        }
      },
      "test-watch": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build",
          "build"
        ],
        "cache": false,
        "options": {
          "command": "pnpm exec vitest",
          "cwd": "packages/plugins"
        }
      }
    }
  }
}
